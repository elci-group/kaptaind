{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kaptaind Desktop",
  "version": "0.1.0",
  "identifier": "com.kaptaind.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kaptaind Release Governance Control Plane",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://localhost:*"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
