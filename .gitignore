# Rust
target/
**/*.rs.bk
# Cargo.lock is intentionally committed: this is a binary crate and reproducible
# builds (and `cargo install --locked`) depend on the pinned dependency graph.

# Environment
.env
.env.local

# Kaptaind runtime artifacts
.kaptaind/
.amber/
daemon.pid

# Other ELCI tools' local runtime/cache state — never source, and some
# (.dumdum/cache in particular) can accumulate thousands of files. These
# got accidentally committed once on a feature branch (2100+ files, 70k+
# lines of generated cache content) and had to be stripped back out
# during a merge; ignoring them here is what should have existed before
# that happened.
.dumdum/
.skillastic/
.vox/

# Prebuilt daemon binaries must never be committed (build via release.yml).
deploy/daemon/

# Node.js / npm
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js / web build
.next/
out/
dist/
*.tsbuildinfo

# Vercel
.vercel

# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.swp
*.swo

# Test artifacts
test-results/
coverage/

# Prisma (keep schema, ignore dev DB)
*.db
*.db-journal

# Tauri
apps/desktop/dist/
apps/desktop/src-tauri/gen/schemas/*.json

# Playwright
playwright-report/

# Local Cargo path overrides (e.g. paths = ["../deckhand"]); do not commit
.cargo/config.toml
